{
  "name": "@cocreate/authorize",
  "version": "1.22.0",
  "description": "A secure, real-time multi-tenant authorization framework and permission evaluation engine featuring hierarchical dot-notation routing, dynamic query filter injection, and deep payload field sanitization.",
  "keywords": [
    "authorization",
    "permission-engine",
    "role-inheritance",
    "data-sanitization",
    "multi-tenant",
    "cache-invalidation",
    "query-filter-injection",
    "field-level-security",
    "access-control",
    "rbac",
    "abac"
  ],
  "publishConfig": {
    "access": "public"
  },
  "cocreate": {
    "environment": [
      "server"
    ],
    "interface": {
      "schemaVersion": 1,
      "summary": "A secure, real-time multi-tenant authorization framework and permission evaluation engine featuring hierarchical dot-notation routing, dynamic query filter injection, and deep payload field sanitization.",
      "source": "src/index.js",
      "api": {
        "exports": [
          "check"
        ]
      }
    }
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cocreatejs/CoCreate-authorize.git"
  },
  "author": "CoCreate LLC",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/CoCreate-app/CoCreate-authorize/issues"
  },
  "homepage": "https://cocreate.app/docs/authorize",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreate-app"
  },
  "type": "module",
  "main": "./src/index.js",
  "dependencies": {
    "@cocreate/crud-client": "^1.37.0",
    "@cocreate/crud-server": "^1.42.0",
    "@cocreate/utils": "^1.54.0"
  }
}
